load port {gain:rsc.triosy:obj.biwt} output -symbol right_portout noname -attr xrf d79923db-977f-41ea-a0cf-1b252d6998b6-750 -attr oid 748 -attr vt d -attr @path {/mult_add_pipeline/mult_add_pipeline:core/mult_add_pipeline:core:gain:rsc.triosy:obj/mult_add_pipeline:core:gain:rsc.triosy:obj:gain:rsc.triosy:wait_ctrl/gain:rsc.triosy:obj.biwt}
load symbol "not(1)" "INTERFACE" INV boxcolor 0 \
     portBus A(0:0) input 1 {A(0)} \
     portBus Z(0:0) output 1 {Z(0)} \

load symbol "and(2,1)" "INTERFACE" AND boxcolor 0 \
     portBus A0(0:0) input 1 {A0(0)} \
     portBus A1(0:0) input 1 {A1(0)} \
     portBus Z(0:0) output 1 {Z(0)} \

